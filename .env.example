# ===== LLM（摘要 + 英文改写）=====
# provider: deepseek | mock
# 没有 DeepSeek key 时可改成 mock，但要先准备 data/demo（python scripts/seed_demo.py）
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.8

# ===== Bilibili =====
# 可选。留空时自动找最新一期依赖本机 bsk 浏览器登录态；也可以直接在控制台贴 BV 号。
BILI_COOKIE=

# ===== 转写 =====
# auto = 先找 B 站字幕，再用本地 SenseVoice（推荐）
# subtitles = 只用字幕；whisper = 只走本地模型
TRANSCRIBE_ENGINE=auto
# SenseVoice 模型目录；scripts/fetch_models.py 会下到这里
FASTER_MODEL=small
WHISPER_DIR=tools/whisper
WHISPER_MODEL=ggml-small.bin
WHISPER_THREADS=8

# ===== 调度 =====
# 1 = 每天固定时间跑；0 = 只手动
SCHEDULE_ENABLED=0
SCHEDULE_TIME=22:00

# ===== 发布 =====
# 1 = 生成成功后自动导出并部署 Cloudflare Pages（需要本机 wrangler 已登录）
AUTO_PUBLISH=0
# 换成你自己在 Cloudflare Pages 创建的项目名；不要直接用 bilmagazine
PAGES_PROJECT=bilmagazine
PAGES_BRANCH=main

# ===== 评论 =====
COMMENTS_ENABLED=1
COMMENTS_TOP_N=5

# ===== 数据目录 =====
DATA_DIR=data
