# ===== LLM（摘要 + 六级改写）=====
# provider: deepseek | mock
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.8

# ===== Bilibili =====
# 浏览器登录后复制整条 Cookie（至少含 SESSDATA）。留空则只能手动指定 BV 号，
# 订阅里的「自动检查最新一期」会被风控挡住（HTTP 412）。
BILI_COOKIE=

# ===== 转写 =====
# engine: auto | subtitles | whisper
#   auto = 先找 B 站字幕，没有再走 whisper.cpp
TRANSCRIBE_ENGINE=auto
WHISPER_DIR=tools/whisper
WHISPER_MODEL=ggml-small.bin
WHISPER_THREADS=8

# ===== 调度 =====
SCHEDULE_ENABLED=1
SCHEDULE_TIME=22:30

# ===== 数据目录 =====
DATA_DIR=data
